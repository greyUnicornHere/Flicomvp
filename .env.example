# Flico environment configuration.
# Copy to .env (`npm run setup` does this for you). .env is ignored by Git — never commit secrets.

# development | production   (tests set "test" automatically)
NODE_ENV=development

# API server. In development the web app runs on http://localhost:5173 and proxies /api here.
HOST=127.0.0.1
PORT=3001

# Public URL people open in the browser. Sign-in links point here.
# Production: must be your real https:// address.
APP_URL=http://localhost:5173

# SQLite database file (created automatically).
DATABASE_PATH=./data/flico.db

# How sign-in emails are delivered:
#   dev-outbox — development only. Emails are NOT sent; open http://localhost:5173/dev/outbox to see them.
#   smtp       — real email via the SMTP settings below. Required in production.
MAIL_TRANSPORT=dev-outbox
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Sign-in link lifetime (minutes, 5–60) and session lifetime (days, 1–30).
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=14

# Sign-in link requests allowed per client address per 15 minutes (1–1000).
AUTH_RATE_LIMIT=10

# Set to true only when running behind a trusted reverse proxy (affects client IP for rate limits).
TRUST_PROXY=false

# ---------- AI (Milestone 3) ----------
# Provider: anthropic | fixture | none. Leave empty to use anthropic when ANTHROPIC_API_KEY is set,
# otherwise AI features show "not configured". "fixture" returns clearly labelled test responses
# for development and automated tests; it is refused in production.
AI_PROVIDER=
# Server-side secret. Never commit it and never put it in client code.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Claude API address. Leave as is unless you use an approved gateway (the key is sent there).
AI_BASE_URL=https://api.anthropic.com
# Longest a single AI request may run (seconds, 10–300).
AI_TIMEOUT_SECONDS=90
# Daily limits per person (reset at midnight UTC). AI never uses analysis credits.
AI_DAILY_DRAFTS=20
AI_DAILY_QUICK_ADDS=100
AI_DAILY_CHAT=150
# AI requests allowed per client address per minute.
AI_RATE_LIMIT=20

# ---------- Analysis (Milestone 4) ----------
# Analysis credits each person starts with. One successful analysis uses one credit.
# Add credits with: npm run credits -- person@example.com 5
ANALYSIS_INITIAL_CREDITS=10
# Longest a single analysis may run (seconds, 30–600).
AI_ANALYSIS_TIMEOUT_SECONDS=180
