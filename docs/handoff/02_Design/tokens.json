{
  "name": "Flico",
  "version": "1.0",
  "theme": "light",
  "reference": "FLICO_DESIGN_SYSTEM.md",
  "color": {
    "background": {
      "page": "#FCFBF8",
      "results": "#FAFAF8",
      "surface": "#FFFFFF",
      "subtle": "#F7FAF8"
    },
    "foreground": {
      "primary": "#202D2C",
      "secondary": "#536B62",
      "muted": "#647773"
    },
    "border": {
      "default": "#E3EAE6",
      "strong": "#C4D2CC"
    },
    "brand": {
