      "fill": "#FFF3E0",
      "stroke": "#E1C397",
      "ink": "#825C21"
    },
    "wait": {
      "fill": "#E9F3FB",
      "stroke": "#B2D0E8",
      "ink": "#285E83"
    },
    "finish": {
      "fill": "#F2F4F2",
      "stroke": "#CAD6D0",
      "ink": "#52675E"
    },
    "exception": {
      "fill": "#FFF0EE",
      "stroke": "#DAAAA4",
      "ink": "#9E4A43"
