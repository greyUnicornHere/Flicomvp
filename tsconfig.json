{
  // Type-checking config for the browser client, shared code, tests and tool configs.
  // The server build uses tsconfig.server.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"],
    "noEmit": true
  },
  "include": ["client/src", "shared", "server", "tests", "*.config.ts"]
}
